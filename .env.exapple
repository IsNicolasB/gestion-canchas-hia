## 💾 Configuración de la base de datos (PostgreSQL) para MantisBT
# ---
# Hostname/Servicio de la DB. Si usas Docker Compose, suele ser el nombre del servicio.
MANTIS_DB_HOST=[DB_HOST_MANTIS]
# Puerto de la DB (ej: 5432).
MANTIS_DB_PORT=[DB_PORT_MANTIS]
# Hostname de la DB (puede dejarse vacío en algunos setups).
MANTIS_DB_HOSTNAME=
# Nombre de la base de datos que usará MantisBT.
MANTIS_DB_NAME=[DB_NAME_MANTIS]
# Usuario de la base de datos para MantisBT.
MANTIS_DB_USER=[DB_USER_MANTIS]
# Contraseña del usuario de la base de datos para MantisBT.
MANTIS_DB_PASS=[DB_PASS_MANTIS]

---

## ⚙️ Configuración principal de MantisBT
# ---
# Salt (semilla) maestra para la criptografía de MantisBT. ¡Debe ser una cadena larga y aleatoria!
MANTIS_CRYPTO_MASTER_SALT=[CADENA_LARGA_ALEATORIA_SECRETA]
# Zona horaria que usará la aplicación MantisBT (ej: America/Buenos_Aires).
MANTIS_TIMEZONE=[TIMEZONE_MANTIS]
# URL de acceso público a MantisBT.
APP_URL=[URL_ACCESO_A_MANTIS]

---

## 📧 Configuración SMTP para envío de correos
# ---
# Dirección de correo electrónico "De" (FROM) para los correos salientes.
SMTP_FROM=[EMAIL_DE_ENVIO]
# Hostname del servidor SMTP.
SMTP_HOST=[SMTP_HOST]
# Modo de conexión (e.g., tls, ssl, none).
SMTP_MODE=[SMTP_MODE]
# Contraseña/Clave API del servidor SMTP. ¡SECRETO!
SMTP_PASS=[SMTP_PASSWORD]
# Puerto del servidor SMTP (ej: 587 o 2525).
SMTP_PORT=[SMTP_PORT]
# Usuario (o Clave API ID) del servidor SMTP.
SMTP_USER=[SMTP_USER]

---

## ☁️ Configuración de la base de datos (PostgreSQL) para Nextcloud
# ---
# Nombre de la base de datos para Nextcloud.
NEXTCLOUD_POSTGRES_DB=[DB_NAME_NEXTCLOUD]
# Usuario de la base de datos para Nextcloud.
NEXTCLOUD_POSTGRES_USER=[DB_USER_NEXTCLOUD]
# Contraseña del usuario de la base de datos para Nextcloud.
NEXTCLOUD_POSTGRES_PASS=[DB_PASS_NEXTCLOUD]

---

## 🧑‍💻 Configuración del administrador de Nextcloud
# ---
# Nombre de usuario del administrador inicial de Nextcloud.
NEXTCLOUD_ADMIN_USER=[ADMIN_USER_NEXTCLOUD]
# Contraseña del administrador inicial de Nextcloud.
NEXTCLOUD_ADMIN_PASS=[ADMIN_PASS_NEXTCLOUD]

---

## ⏱️ Zona horaria general del contenedor/sistema
# ---
# Zona horaria que usará el contenedor Docker (ej: America/Argentina/Buenos_Aires).
TZ=[TIMEZONE_GLOBAL]